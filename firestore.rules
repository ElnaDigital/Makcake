rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'natnaelagizew27@gmail.com'
        ];
    }

    function getActivePackageId() {
      return exists(/databases/$(database)/documents/settings/subscription)
        ? get(/databases/$(database)/documents/settings/subscription).data.activePackageId
        : 'pkg-basic';
    }

    function isAdvancedOrHigher() {
      return getActivePackageId() in ['pkg-advanced', 'pkg-premium'];
    }

    function isPremiumPlan() {
      return getActivePackageId() == 'pkg-premium';
    }

    function isValidOrderCreate(orderId) {
      let d = request.resource.data;
      return !exists(/databases/$(database)/documents/orders/$(orderId))
        && d.keys().hasAll([
          'id', 'firestoreDocId', 'status', 'paymentStatus',
          'customerName', 'phone', 'address', 'paymentPlan',
          'paymentMethod', 'total', 'createdAt', 'source'
        ])
        && d.keys().hasOnly([
          'id', 'firestoreDocId', 'status', 'customerName', 'phone',
          'fulfillment', 'address', 'deliveryDate', 'timeSlot',
          'paymentPlan', 'paymentMethod', 'paymentRef', 'paymentStatus',
          'dueNow', 'balanceDue', 'receiptImg', 'receiptOmitted',
          'cakeName', 'cakeImg', 'size', 'flavor', 'inscription',
          'decorations', 'addons', 'total', 'isNewFlash',
          'createdAt', 'updatedAt', 'source', 'businessId', 'isDemo'
        ])
        && d.firestoreDocId == orderId
        && (d.id is int || d.id is string)
        && d.status == 'Payment Pending'
        && d.paymentStatus == 'Unpaid'
        && d.source == 'web_firestore'
        && (!('businessId' in d) || (d.businessId is string && d.businessId.size() <= 120))
        && (!('isDemo' in d) || d.isDemo is bool)
        && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 120
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
        && d.address is string && d.address.size() > 0 && d.address.size() <= 300
        && d.paymentPlan in ['full', 'half', 'cod']
        && d.paymentMethod is string && d.paymentMethod.size() > 0 && d.paymentMethod.size() <= 40
        && d.total is number && d.total > 0 && d.total <= 500000
        && (!('dueNow' in d) || (d.dueNow is number && d.dueNow >= 0))
        && (!('balanceDue' in d) || (d.balanceDue is number && d.balanceDue >= 0))
        && (!('receiptImg' in d) || (d.receiptImg is string && d.receiptImg.size() <= 750000))
        && (!('receiptOmitted' in d) || d.receiptOmitted is bool)
        && (!('inscription' in d) || (d.inscription is string && d.inscription.size() <= 200))
        && (!('decorations' in d) || d.decorations is list)
        && (!('addons' in d) || d.addons is list)
        && d.createdAt is string && d.createdAt.size() > 0 && d.createdAt.size() <= 64;
    }

    function isValidOrderStatusCreate(orderId) {
      let s = request.resource.data;
      return !exists(/databases/$(database)/documents/order_status/$(orderId))
        && s.keys().hasAll(['id', 'firestoreDocId', 'status', 'paymentStatus', 'updatedAt'])
        && s.keys().hasOnly(['id', 'firestoreDocId', 'status', 'paymentStatus', 'updatedAt'])
        && s.firestoreDocId == orderId
        && (s.id is int || s.id is string)
        && s.status == 'Payment Pending'
        && s.paymentStatus == 'Unpaid'
        && s.updatedAt is string && s.updatedAt.size() > 0 && s.updatedAt.size() <= 64;
    }

    // Orders: Customers may create valid new orders without signing in;
    // only verified authorized admin(s) may read, list, update, or delete.
    match /orders/{orderId} {
      allow create: if isValidOrderCreate(orderId);
      allow read, update, delete: if isAuthorizedAdmin()
        && (!('businessId' in resource.data) || resource.data.businessId == request.auth.token.email);
    }

    // Public order status projection (zero PII; unguessable 20-char docId, no listing)
    match /order_status/{orderId} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidOrderStatusCreate(orderId);
      allow update, delete: if isAuthorizedAdmin();
    }

    // Catalog, recent creations, decorations & public shop settings:
    // readable by storefront, writable only by authorized admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /creations/{creationId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /decorations/{decId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isAdvancedOrHigher();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Subscription package doc: readable by app, NEVER writable by any client
    // (update manually in Firebase Console after confirming payment)
    match /settings/subscription {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Immutable audit trail for sensitive admin operations (never stores passwords)
    match /audit_logs/{logId} {
      allow read: if isAuthorizedAdmin();
      allow create: if isAuthorizedAdmin();
      allow update, delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
