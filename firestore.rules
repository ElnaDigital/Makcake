rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'natnaelagizew27@gmail.com'
        ];
    }

    function isValidOrderCreate(orderId) {
      let d = request.resource.data;
      return !exists(/databases/$(database)/documents/orders/$(orderId))
        && d.keys().hasAll([
          'id', 'firestoreDocId', 'status', 'paymentStatus',
          'customerName', 'phone', 'address', 'paymentPlan',
          'paymentMethod', 'total', 'createdAt', 'source'
        ])
        && d.keys().hasOnly([
          'id', 'firestoreDocId', 'status', 'customerName', 'phone',
          'fulfillment', 'address', 'deliveryDate', 'timeSlot',
          'paymentPlan', 'paymentMethod', 'paymentRef', 'paymentStatus',
          'dueNow', 'balanceDue', 'receiptImg', 'receiptOmitted',
          'cakeName', 'cakeImg', 'size', 'flavor', 'inscription',
          'decorations', 'addons', 'total', 'isNewFlash',
          'createdAt', 'updatedAt', 'source'
        ])
        && d.firestoreDocId == orderId
        && (d.id is int || d.id is string)
        && d.status == 'Payment Pending'
        && d.paymentStatus == 'Unpaid'
        && d.source == 'web_firestore'
        && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 120
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
        && d.address is string && d.address.size() > 0 && d.address.size() <= 300
        && d.paymentPlan in ['full', 'half', 'cod']
        && d.paymentMethod is string && d.paymentMethod.size() > 0 && d.paymentMethod.size() <= 40
        && d.total is number && d.total > 0 && d.total <= 500000
        && (!('dueNow' in d) || (d.dueNow is number && d.dueNow >= 0))
        && (!('balanceDue' in d) || (d.balanceDue is number && d.balanceDue >= 0))
        && (!('receiptImg' in d) || (d.receiptImg is string && d.receiptImg.size() <= 750000))
        && (!('receiptOmitted' in d) || d.receiptOmitted is bool)
        && (!('inscription' in d) || (d.inscription is string && d.inscription.size() <= 200))
        && (!('decorations' in d) || d.decorations is list)
        && (!('addons' in d) || d.addons is list)
        && d.createdAt is string && d.createdAt.size() > 0 && d.createdAt.size() <= 64;
    }

    // Orders: Customers may create valid new orders without signing in;
    // only verified authorized admin(s) may read, list, update, or delete.
    match /orders/{orderId} {
      allow create: if isValidOrderCreate(orderId);
      allow read, update, delete: if isAuthorizedAdmin();
    }

    // Catalog & public shop settings: readable by storefront, writable only by admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
